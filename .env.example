# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Publishable key — starts with `sb_publishable_`.
# Safe to expose in the browser; RLS still applies. Replaces the legacy
# `anon` JWT. Dashboard: Settings -> API Keys -> Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Secret key — starts with `sb_secret_`.
# SECRET: bypasses row-level security entirely. Server-side only; never
# expose to the browser and never prefix with NEXT_PUBLIC_. Replaces the
# legacy `service_role` JWT. Can be rotated independently, and you can issue
# a separate secret key per backend component.
# Dashboard: Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Legacy `anon` / `service_role` JWTs still work in these same variables but
# are deprecated by Supabase at the end of 2026. Prefer the sb_* keys above.

# --- Legacy butchers-directory project (optional) --------------------------
# Only needed to re-run scripts/migrate-to-pilates-db.js or
# scripts/export-pilates-data.js against the old database.
OLD_SUPABASE_SERVICE_ROLE_KEY=

# --- Google (optional) -----------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Search Console verification. If unset, no verification meta tag is rendered.
GOOGLE_SITE_VERIFICATION=
