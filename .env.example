# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Publishable key — starts with `sb_publishable_`.
# Safe to expose in the browser; RLS still applies. Replaces the legacy
# `anon` JWT. Dashboard: Settings -> API Keys -> Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Secret key — starts with `sb_secret_`.
# SECRET: bypasses row-level security entirely. Server-side only; never
# expose to the browser and never prefix with NEXT_PUBLIC_. Replaces the
# legacy `service_role` JWT. Can be rotated independently, and you can issue
# a separate secret key per backend component.
# Dashboard: Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Legacy `anon` / `service_role` JWTs still work in these same variables but
# are deprecated by Supabase at the end of 2026. Prefer the sb_* keys above.

# --- Legacy butchers-directory project (optional) --------------------------
# Only needed to re-run scripts/migrate-to-pilates-db.js or
# scripts/export-pilates-data.js against the old database.
OLD_SUPABASE_SERVICE_ROLE_KEY=

# --- Google (optional) -----------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Search Console verification. If unset, no verification meta tag is rendered.
GOOGLE_SITE_VERIFICATION=

# --- Admin area (required for /admin) --------------------------------------
# The password for /admin/login. Anything long and random.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing either of these signs every open admin session out.
ADMIN_SESSION_SECRET=

# Where "something is waiting for review" notifications go. If unset, nothing
# is sent and the queues at /admin are the only signal.
ADMIN_EMAIL=

# --- Email (required for owner sign-in) ------------------------------------
# Resend API key. Without it, emails are written to the server log instead of
# being sent - useful in development, useless in production: studio owners
# cannot sign in without receiving their link.
RESEND_API_KEY=

# Sender for every outbound email. The domain must be verified in Resend.
EMAIL_FROM="Pilates Classes Near <info@pilatesclassesnear.com>"

# Absolute base for links inside emails. Defaults to the live site in
# production and http://localhost:3000 otherwise.
NEXT_PUBLIC_SITE_URL=

# --- Featured listings (Stripe) --------------------------------------------
# Without these the dashboard hides the option and nothing can be bought;
# everything else on the site works unchanged.

# Secret key: sk_live_… in production, sk_test_… while testing.
STRIPE_SECRET_KEY=

# The recurring price to charge, created in Stripe as £29/month GBP.
# Dashboard: Product catalogue -> your product -> Pricing -> price id (price_…).
STRIPE_PRICE_ID=

# Signing secret for the webhook at /api/stripe/webhook (whsec_…).
# This is what proves an event came from Stripe. Without it, no subscription
# is ever activated, because the browser's return from Checkout is not
# treated as proof of payment.
STRIPE_WEBHOOK_SECRET=

# --- Photos ----------------------------------------------------------------
# Owner uploads go to the "studio-photos" Supabase Storage bucket, created by
# supabase/migrations/20260828_studio_photos.sql. No extra keys are needed:
# uploads go through the server route using SUPABASE_SECRET_KEY.
